  "spellingExceptions": {
    "$comment": "Words the spelling map would otherwise break. Matched case-sensitively as whole strings.",
    "identifiers": [
      "cancelled",
      "endedReason",
      "colour"
    ],
    "note": "'cancelled' is a PostgreSQL check-constraint value (supabase/migrations/0014_quests.sql) and a local variable name in several effects. The lint only ever reads copy spans and comments, never identifiers or data values, so those are safe by construction — this list is here so the next person does not 'fix' them by hand."
  },
  "caps": {
    "$comment": "Sentence case everywhere. These are the only strings allowed to be all-caps, and only because they are abbreviations or units.",
    "maxAllCapsLength": 5
  }

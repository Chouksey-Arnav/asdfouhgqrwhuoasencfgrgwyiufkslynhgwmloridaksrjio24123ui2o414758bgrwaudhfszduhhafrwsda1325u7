  "terms": [
    {
      "prefer": "shadowing",
      "instead": [
        "clinical observation",
        "clinical observations",
        "observation hours"
      ],
      "why": "One word for one thing. Students say shadowing, programs ask for shadowing hours, and 'clinical observation' is the same activity in a lab coat."
    },
    {
      "prefer": "activities",
      "instead": [
        "extracurricular",
        "extracurriculars",
        "extra-curricular",
        "extra curriculars"
      ],
      "why": "Shorter, and the word the Common App uses for the same list. 'Extracurricular' also quietly implies the thing is optional garnish, which is the opposite of what this app is telling students."
    },
    {
      "prefer": "pathway",
      "instead": [
        "career track",
        "career tracks",
        "career path",
        "career paths",
        "your track",
        "their track",
        "the track you"
      ],
      "why": "The named route a student is on is a pathway, everywhere, always. 'Track' is still fine as a VERB — you track an opportunity — and that is the only sense it keeps."
    },
    {
      "prefer": "program",
      "instead": [
        "school list",
        "target school",
        "target schools",
        "dream school",
        "dream schools",
        "reach school",
        "reach schools",
        "safety school",
        "safety schools"
      ],
      "why": "You apply to a program, not to a school: a BS/MD program and the university around it have different odds, different requirements and different deadlines. 'Medical school' stays as the generic level of education, and a college is still a college — an institution is not the same thing as an offering."
    },
    {
      "prefer": "program",
      "instead": [
        "programme",
        "programmes"
      ],
      "why": "American spelling; see below."
    }
  ],
